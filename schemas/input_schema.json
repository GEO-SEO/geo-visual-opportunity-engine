{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "E-commerce Automator - Input Parameters",
  "description": "E-commerce Automator v3.0 supports two modes: GEO Analysis and Product Creation. This schema defines all input parameters.",
  "type": "object",
  "oneOf": [
    {
      "title": "Mode 1: GEO Opportunity Analysis",
      "description": "Analyze brand/product/keywords to identify visual marketing opportunities and generate AI-ready content",
      "required": ["mode", "brand", "product", "core_keyword", "country", "language"],
      "properties": {
        "mode": {
          "type": "string",
          "const": "geo_analysis",
          "title": "Operation Mode",
          "description": "Set to 'geo_analysis' for GEO opportunity analysis"
        },
        "brand": {
          "type": "string",
          "title": "Brand Name",
          "description": "Brand name to analyze",
          "examples": ["AcmeWatch", "ZenithBrew", "OceanTech"],
          "minLength": 1,
          "maxLength": 100
        },
        "product": {
          "type": "string",
          "title": "Product Name",
          "description": "Specific product to promote",
          "examples": ["Acme DivePro 5", "Portable Cold Brew Coffee Maker", "Smart Home Hub"],
          "minLength": 1,
          "maxLength": 200
        },
        "core_keyword": {
          "type": "string",
          "title": "Core Keyword",
          "description": "Main keyword/phrase for the brand/product",
          "examples": ["smartwatch water resistance", "cold brew coffee maker", "smart home automation"],
          "minLength": 1,
          "maxLength": 200
        },
        "country": {
          "type": "string",
          "title": "Target Country",
          "description": "Target market country code (ISO 3166-1 alpha-2)",
          "examples": ["us", "uk", "jp", "de", "fr", "es", "br", "au"],
          "enum": ["us", "uk", "ca", "au", "jp", "kr", "cn", "de", "fr", "es", "it", "pt", "ru", "br", "in", "sg", "mx"]
        },
        "language": {
          "type": "string",
          "title": "Output Language",
          "description": "Content output language code",
          "examples": ["en", "zh", "ja", "es", "fr", "de", "ko", "pt", "it", "ru"],
          "enum": ["en", "zh", "ja", "es", "fr", "de", "ko", "pt", "it", "ru"]
        },
        "competitors": {
          "type": "array",
          "title": "Competitors",
          "description": "Competitor brands to analyze (optional, max 10)",
          "items": {
            "type": "string"
          },
          "maxItems": 10,
          "examples": [["BrandA", "BrandB"], ["Nespresso", "Starbucks"], ["Apple", "Samsung"]]
        },
        "platform_focus": {
          "type": "array",
          "title": "AI Platform Focus",
          "description": "Target AI platforms for optimization",
          "items": {
            "type": "string",
            "enum": ["ChatGPT", "Perplexity", "Grok", "Gemini", "Claude", "Copilot"]
          },
          "examples": [["ChatGPT", "Grok"], ["Perplexity", "Gemini"]],
          "uniqueItems": true
        },
        "generate_images": {
          "type": "boolean",
          "title": "Generate Images",
          "description": "Whether to auto-generate images using Nano Banana 2",
          "default": true
        }
      }
    },
    {
      "title": "Mode 2: E-commerce Product Creation",
      "description": "Auto-generate product data, create images, and publish to Shopify/WooCommerce",
      "required": ["mode", "product_name"],
      "properties": {
        "mode": {
          "type": "string",
          "const": "create_product",
          "title": "Operation Mode",
          "description": "Set to 'create_product' for e-commerce product creation"
        },
        "product_name": {
          "type": "string",
          "title": "Product Name",
          "description": "Product name (required)",
          "examples": ["Wireless Bluetooth Headphones Pro", "Premium Yoga Mat", "Smart Watch Band"],
          "minLength": 1,
          "maxLength": 200
        },
        "category": {
          "type": "string",
          "title": "Product Category",
          "description": "Product category (optional)",
          "examples": ["Electronics", "Clothing", "Home & Garden", "Sports", "Beauty"],
          "maxLength": 100
        },
        "base_price": {
          "type": "number",
          "title": "Base Price",
          "description": "Product price in USD (optional, will auto-generate if not provided)",
          "minimum": 0.01,
          "maximum": 99999.99,
          "examples": [79.99, 199.00, 49.50]
        },
        "description": {
          "type": "string",
          "title": "Product Description",
          "description": "Product description (optional, auto-generates if not provided)",
          "maxLength": 5000
        },
        "language": {
          "type": "string",
          "title": "Output Language",
          "description": "Content output language code",
          "examples": ["en", "zh"],
          "enum": ["en", "zh", "ja", "es", "fr", "de", "ko", "pt", "it", "ru"],
          "default": "en"
        },
        "target_platforms": {
          "type": "array",
          "title": "Target Platforms",
          "description": "E-commerce platforms to publish to",
          "items": {
            "type": "string",
            "enum": ["shopify", "woocommerce"]
          },
          "examples": [["shopify"], ["woocommerce"], ["shopify", "woocommerce"]],
          "default": ["shopify", "woocommerce"]
        },
        "generate_images": {
          "type": "boolean",
          "title": "Generate Product Image",
          "description": "Whether to generate product image using Nano Banana 2",
          "default": true
        },
        "image_style": {
          "type": "string",
          "title": "Image Style",
          "description": "Style of product image to generate",
          "enum": ["white_info", "lifestyle", "hero"],
          "default": "white_info"
        },
        "publish_to_shopify": {
          "type": "boolean",
          "title": "Publish to Shopify",
          "description": "Whether to publish product to Shopify store",
          "default": false
        },
        "publish_to_woocommerce": {
          "type": "boolean",
          "title": "Publish to WooCommerce",
          "description": "Whether to publish product to WooCommerce store",
          "default": false
        }
      }
    }
  ],
  "default": {
    "mode": "geo_analysis"
  },
  "ui": {
    "mode": {
      "field": "select",
      "options": [
        {"value": "geo_analysis", "label": "GEO Opportunity Analysis"},
        {"value": "create_product", "label": "E-commerce Product Creation"}
      ]
    }
  }
}
